{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Crimson Workbench",
  "version": "0.5.9",
  "identifier": "local.crimson.workbench",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://127.0.0.1:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Crimson Workbench",
        "width": 1440,
        "height": 920,
        "minWidth": 960,
        "minHeight": 680,
        "visible": false,
        "backgroundColor": "#141615",
        "theme": "Dark"
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; connect-src ipc: http://ipc.localhost; object-src 'none'; base-uri 'self'; frame-src 'none'",
      "capabilities": [
        "main-read-only"
      ]
    }
  },
  "bundle": {
    "active": false
  }
}
